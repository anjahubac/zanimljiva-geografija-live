PORT=3000
NODE_ENV=development
ROUND_DURATION_MS=150000
COUNTDOWN_MS=3000
COMPLETED_ROOM_TTL_MS=300000
WAITING_ROOM_TTL_MS=1800000

# Copy to .env (never commit .env). On the host, set the same names as
# environment variables / secrets instead.

# AI: the answer checker, the AI opponent and hints (Plan.md §2B).
# Set GEMINI_API_KEY, GROQ_API_KEY, or both. With both, each is the other's
# fallback: when one fails, times out or runs out of free quota, the next
# attempt goes to the other.

# Google Gemini.
# A free key from https://aistudio.google.com/apikey. Create it in a Google
# project WITHOUT billing, so an exhausted quota can never cost money.
# Free-tier requests may be used by Google to improve its products; the lobby
# tells players so. Without a key the game still works: answers are checked by
# the starting letter only, and "Play against AI" and hints are unavailable.
GEMINI_API_KEY=

# Optional. Comma-separated, tried in order; the next model is used only when
# the previous one fails with a temporary error or is out of its daily quota.
# Stable model ids only. Default (from the colleague's live testing):
# GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash

# Optional. Overrides the thinking level for every model (minimal|low|medium|high).
# GEMINI_THINKING_LEVEL=

# Local debugging only: print what is sent to the model and what it replies,
# in the server terminal. Never the key. Ignored when NODE_ENV=production.
# AI_DEBUG_LOG=1

# Groq. A free key from https://console.groq.com/keys (no card needed).
# By default Groq does not keep request data; turning on Zero Data Retention in
# its Data Controls also disables its 30-day abuse log.
GROQ_API_KEY=

# Optional. Default: openai/gpt-oss-120b,openai/gpt-oss-20b (both support
# strict JSON output on Groq). Free plan: about 1,000 requests/day per model.
# GROQ_MODEL_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional. Which provider is tried first: gemini,groq (default) or groq,gemini.
# List one name to use only that provider, e.g. to test it alone.
# AI_PROVIDER_ORDER=gemini,groq

# AI usage limits (Plan.md §2B.11). The free quota is shared by every player.
# Per visitor (client address), per hour:
# AI_ROOMS_PER_VISITOR_HOUR=10
# HINTS_PER_VISITOR_HOUR=20
# All AI calls in a UTC day; once spent, no new AI games or hints, but games
# already played are still checked:
# AI_DAILY_CALL_BUDGET=1500
# Round-coach runs per visitor per hour (Plan.md §2C.8); each run's model steps
# also count toward the daily budget above:
# COACH_RUNS_PER_VISITOR_HOUR=6
# How many proxies in front of the server add an x-forwarded-for entry.
# 0 locally. On Render set it (see Plan.md §2B.11): with 0 behind a proxy,
# every visitor shares one limit.
# TRUST_PROXY_HOPS=0
